#!/bin/sh
# pre-push — corre preflight.sh antes de dejar pushear la rama de deploy.
#
# Por qué existe: `preflight.sh` era un paso manual, y los pasos manuales se
# saltan. El 2026-08-27 un refactor tiró /catalogo EN PRODUCCIÓN porque nadie
# corría eslint; el 2026-09-02 un patch llevaba un día sin commitear y se creía
# deployado. Las dos veces la herramienta existía y nadie la invocó.
#
# Solo actúa sobre la rama que se DEPLOYA. Pushear una rama de trabajo no paga
# el costo: lo que se revisa es lo que va a construir la imagen.
#
# ACTIVAR (una vez por máquina — esto NO viaja en el repo, es config local):
#     git config core.hooksPath .githooks
#
# Si de verdad necesitas saltarlo: git push --no-verify
# Pero si lo estás escribiendo, pregúntate qué te está avisando.

RAMA_DEPLOY=main

correr=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    [ "$remote_ref" = "refs/heads/$RAMA_DEPLOY" ] && correr=1
done

[ "$correr" = 1 ] || exit 0

raiz=$(git rev-parse --show-toplevel)
[ -f "$raiz/preflight.sh" ] || { echo "pre-push: falta preflight.sh"; exit 1; }

echo "pre-push: rama $RAMA_DEPLOY -> corriendo preflight.sh"
if bash "$raiz/preflight.sh"; then
    exit 0
fi

echo ""
echo "❌ push BLOQUEADO: preflight falló."
echo "   Si tienes trabajo a medias que no va en este push: git stash -u"
exit 1
